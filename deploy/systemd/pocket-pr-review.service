[Unit]
Description=Pocket PR Review — breathe, sit, notice
After=network-online.target
Wants=network-online.target

[Service]
User=pocket-pr-review
Group=pocket-pr-review
ExecStart=/usr/local/bin/pocket-pr-review
Environment=DATA_DIR=/var/lib/pocket-pr-review
Environment=PORT=8080
Environment=BASE_URL=https://pr.example.com
Environment=SECURE_COOKIES=true
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/pocket-pr-review
PrivateTmp=true

[Install]
WantedBy=multi-user.target
